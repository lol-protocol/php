{
  "name": "privacy-laws",
  "version": "1.0.0",
  "description": "Global privacy laws database by country - for genealogy and privacy compliance projects",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "validate": "node scripts/validate-csv.js",
    "build": "node scripts/reorganize-by-country.js",
    "build:check": "node scripts/reorganize-by-country.js --check",
    "cache:texts": "php scripts/cache-texts.php",
    "test:e2e": "node --test --test-concurrency=1 'tests/e2e/*.e2e.js'",
    "check:links": "node scripts/check-links.js"
  },
  "keywords": [
    "privacy",
    "gdpr",
    "ccpa",
    "lgpd",
    "data-protection",
    "genealogy",
    "compliance"
  ],
  "author": "lol-protocol",
  "license": "MIT",
  "devDependencies": {
    "axe-core": "4.10.3",
    "csv-parse": "7.0.3",
    "playwright": "1.56.1"
  }
}
