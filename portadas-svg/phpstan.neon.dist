parameters:
    level: max
    paths:
        - src
        - bin
        - pruebas
    # PiezasSegunInterruptores carga LolProtocol\Interruptores\Interruptores en tiempo de ejecución desde la
    # carpeta hermana (no es una dependencia de composer): se la damos a PHPStan.
    scanDirectories:
        - ../interruptores/src
