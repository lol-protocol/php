{
    "name": "lol-protocol/phone-directory",
    "description": "Phone Directory Parser module for parsing historical phone directories and organizing genealogical records",
    "license": "MIT",
    "authors": [
        {
            "name": "LOL Protocol Team"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../defamatory-content-review",
            "options": {
                "symlink": true,
                "versions": {
                    "lol-protocol/defamatory-content-review": "4.3.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "lol-protocol/defamatory-content-review": "^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "bin": [
        "bin/phonedir"
    ],
    "autoload": {
        "psr-4": {
            "PhoneDirectory\\": "src/PhoneDirectory/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
