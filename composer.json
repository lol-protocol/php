{
    "name": "lol-protocol/php",
    "description": "Monorepo: defamatory content review engine (apps/content-review) and the genealogy/POS URL routing system (apps/routing) for the LOL Protocol platform",
    "license": "MIT",
    "authors": [
        {
            "name": "LOL Protocol Team"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DefamatoryContentReview\\": "apps/content-review/src/DefamatoryContentReview/",
            "App\\": "apps/routing/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": [
                "apps/content-review/tests/",
                "apps/routing/tests/"
            ]
        }
    }
}
