%% Arquitectura por capas. La búsqueda es equivalente en PHP y Java y se comprueba con
%% pruebas/vectores.tsv. Los EPUB, las colecciones, el modo largo, la paráfrasis, la web y el modo con IA son solo PHP.
flowchart TB
    subgraph interfaz["Capa de interfaz"]
        paginaweb["web/index.html + app.js<br/>(sin scripts en línea, CSP estricta)"]
        apiphp["web/api.php"]
        chatphp["bin/chat.php<br/>REPL en la terminal"]
        chatjava["Chat.java<br/>REPL en la terminal"]
        paginaweb -- "fetch JSON" --> apiphp
    end

    subgraph php["Núcleo PHP (src/)"]
        direction TB
        api["Api<br/>Host/Origin, JSON, límites,<br/>libros de una lista fija"]
        dialogo["Dialogo<br/>reglas, búsqueda o IA"]
        conv_php["Conversador<br/>intención + pasajesPara"]
        ind_php["Indice<br/>TF-IDF + coseno"]
        sin_php["Sinonimos"]
        libro_php["Libro<br/>título, autor, capítulos, pasajes"]
        norm_php["Normaliza<br/>minúsculas, sin acentos,<br/>palabras vacías, raíz"]
        bib["Biblioteca<br/>.txt, .epub y carpetas (colecciones)"]
        epub["Epub<br/>zip + DOM, con topes y sin red"]
        ajustes["Ajustes<br/>párrafos, o libro largo (1000+ pasajes)"]
        ventanas["Ventanas<br/>de 3 oraciones, con solape"]
        parafrasea["Parafrasea<br/>moderno u original, sin inventar"]
        gen["Generador (interfaz)"]
        claude["GeneradorClaude<br/>SDK de Anthropic (opcional)"]
        api --> bib
        api --> dialogo
        bib --> libro_php
        bib --> epub
        epub --> libro_php
        conv_php --> ajustes
        ajustes --> ventanas
        conv_php -. "libro largo" .-> parafrasea
        dialogo --> conv_php
        dialogo -. "solo con IA" .-> gen
        gen --> claude
        conv_php --> ind_php
        conv_php --> libro_php
        conv_php --> sin_php
        conv_php --> norm_php
        ind_php -.-> norm_php
        libro_php --> norm_php
        sin_php --> norm_php
    end

    subgraph java["Núcleo Java (java/src/chatlibros/)"]
        direction TB
        conv_java["Conversador"]
        ind_java["Indice"]
        sin_java["Sinonimos"]
        libro_java["Libro + Pasaje"]
        norm_java["Normaliza"]
        conv_java --> ind_java
        conv_java --> libro_java
        conv_java --> sin_java
        conv_java --> norm_java
        ind_java -.-> norm_java
        libro_java --> norm_java
        sin_java --> norm_java
    end

    apiphp --> api
    chatphp --> bib
    chatphp --> dialogo
    chatjava --> conv_java

    anthropic{{"API de Anthropic"}}
    claude -- "HTTPS" --> anthropic

    sinonimos[("datos/sinonimos.tsv")]
    sinonimos -.-> sin_php
    sinonimos -.-> sin_java

    vectores[("pruebas/vectores.tsv<br/>consulta, pasaje, puntaje")]
    evaluacion[("pruebas/evaluacion.tsv")]
    consultas[("pruebas/consultas.txt")]
    genvec["bin/vectores.php<br/>(genera o --comprobar)"]

    consultas --> genvec
    conv_php -. "puntajes" .-> genvec
    genvec --> vectores
    vectores -. "debe coincidir" .-> ind_php
    vectores -. "debe coincidir" .-> ind_java
    evaluacion -. "aciertos con y sin sinónimos" .-> ind_php
