# Copy this file to .env and adjust values for your environment.
# Config::get() falls back to these when no real environment variable is set.

# --- Application ---
# Enables verbose error output. Never "true" in production.
DEBUG=false

# Time zone of the whole app, the cron jobs included (Config::load() sets it; see
# docs/DATABASE.md, "Zona horaria"). The dates in the database have no zone, so the
# web server and the cron jobs must read them in the same one, and this is what makes
# them: not each php.ini. Default UTC. On a site that already has rows, changing it
# moves their dates (a pedido de retiro would look hours older or younger).
#APP_TIMEZONE=UTC

# Brand shown in the genealogy site's header and page titles. Keep it equal to
# "marca" in ../marketing/config.json (a separate project, so it is not read from
# there). Left empty, the header says "Genealogía". The POS site is always
# "Contrastocolor".
SITE_NAME_GENEALOGY=conce.com

# The genealogy site's public address, e.g. https://conce.com, used for the
# absolute URLs in /robots.txt and the sitemaps. Left empty, they use the
# request's scheme and host.
SITE_URL_GENEALOGY=
# The same for the POS (Contrastocolor), e.g. https://contrastocolor.com.
SITE_URL_POS=

# Folder where the sitemaps remember since when each file lists what it lists
# (its <lastmod> in the index and its Last-Modified; see Support/SitemapEstado.php).
# Use one that survives a reboot, e.g. /var/lib/url-routing/sitemaps: in the system
# temp dir (the default) the dates start over whenever it is emptied.
SITEMAP_ESTADO_DIR=

# --- Languages (Support/HostParser.php) ---
# The language is a subdomain (spa.tudominio.com, eng.…). Comma-separated list of the ones this site serves,
# from the 30 it knows (spa, eng, fra, deu, por, ita, ara, zho, jpn, kor, rus, tur, ...: see
# HostParser::IDIOMAS_CONOCIDOS). Spanish is always served. Only these are read as a language and announced in
# hreflang: list a language only once its pages are written in it. Each one also needs its DNS record and a
# certificate for its subdomain (a wildcard covers every language at once).
IDIOMAS_ACTIVOS=spa,eng

# --- Domain routing (index.php) ---
# Comma-separated list of hostnames served by the POS (Contrastocolor) site.
# Any other host falls back to the genealogy site.
POS_DOMAINS=contrastocolor.local,contrastocolor.test,contrastocolor.app

# --- Check digit of ids (Support/DigitoVerificador.php) — see docs/URL_STRUCTURES.md ---
# true: the last digit of every id (not an order's random code) is a check digit computed from the others, and an
# id whose digit does not add up answers 404 without a query. Leave it false unless EVERY id in the database ends
# in its check digit: turning it on over plain numbers makes almost all of them answer 404. `php bin/id.php`
# completes and verifies ids. Decide it before the site opens: after that, changing an id breaks the links out there.
IDS_DIGITO_VERIFICADOR=false

# --- Count of 404 and 301 by URL shape (Support/RegistroDeUrls.php; report: php bin/urls-informe.php) ---
# Folder for the day files. It keeps only the SHAPE of the URL (an id of 10 digits is #10, a name typed into a path
# is ?), never the path, the query, the IP or who asked. Empty: a folder in the system temp dir (volatile; use
# /var/lib/url-routing/urls to keep the history); "off": nothing is recorded. 60 days are kept.
URL_LOG_DIR=

# --- Owner access (Support/AccessPolicy.php) — see docs/ACCESO.md ---
# The secret that proves who the owner is. Everything private needs it: private
# colecciones, the account area (/0/), the edit page and POS orders. At least 20
# characters; make one with `openssl rand -hex 32`. Left empty, all of that
# stays closed to everyone, which is the safe default. It travels in the
# Authorization header, so serve the site over HTTPS. Changing it logs the
# owner out everywhere.
OWNER_TOKEN=

# --- Pedidos de retiro (bin/pedidos-retiro.php) ---
# Hours a pedido de retiro may wait for the owner (/0/3/) before the cron job
# calls it late and, if run with --ocultar, hides the page while it is reviewed.
# Hiding is never automatic unless that cron job is set up: see docs/DESPLIEGUE.md.
RETIRO_PLAZO_HORAS=24
# Pedidos de retiro that one visitor may send per hour, and that one page may have
# waiting before it stops taking more. Defaults: 3 and 10 (docs/ACCESO.md).
#RETIRO_MAX_POR_HORA=3
#RETIRO_MAX_PENDIENTES=10
# Months a resolved pedido keeps the sender's e-mail and text before
# `php bin/pedidos-retiro.php --depurar` erases them. Default: 12.
#RETIRO_CONSERVAR_MESES=12
# --- Solicitudes de datos (/s/{id}/, bin/solicitudes.php) ---
# Solicitudes de acceso, rectificación o supresión que un visitante puede enviar por hora, y que
# una persona puede tener esperando antes de dejar de aceptar más. Defaults: 3 y 5.
#SOLICITUD_MAX_POR_HORA=3
#SOLICITUD_MAX_PENDIENTES=5
# Meses que una solicitud cerrada guarda el correo y el texto de quien la envió antes de que
# `php bin/solicitudes.php --depurar` los borre. Default: 12.
#SOLICITUD_CONSERVAR_MESES=12
# --- Entregas con clave (/e/{token}/, bin/persona.php entrega) ---
# Claves que un visitante puede probar por hora entre todos los enlaces. Default: 10 (docs/SOLICITUDES.md).
#ENTREGA_MAX_POR_HORA=10
# Where defamatory-content-review/ is, when it is not next to url-routing/ (the filter
# that marks the pedidos; without it they are saved unmarked). docs/DESPLIEGUE.md.
#FILTRO_DIFAMACION_DIR=/var/www/defamatory-content-review

# --- Rate limiting (Support/RateLimiter.php) ---
# Comma-separated IPs of your own reverse proxies / load balancers. Only when
# the direct peer is one of these is X-Forwarded-For used to find the client
# IP; leave empty when the app is exposed directly.
TRUSTED_PROXIES=

# --- Logging (Support/Logger.php) ---
# Absolute path to the log file. Defaults to sys_get_temp_dir()/app.log.
LOG_FILE=/var/log/app/app.log
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Databases (Support/Database.php) — see docs/DATABASE.md ---
# Each site needs its own database (their tables share names): DB_DSN_<SITE>,
# or sqlite:var/<site>.sqlite when unset (local development). There is no
# shared DB_DSN. The same SQL runs on SQLite and PostgreSQL; pick per site
# by volume.
#
# Genealogy: PostgreSQL recommended in production (large, recursive, many writers).
DB_DSN_GENEALOGY=pgsql:host=127.0.0.1;port=5432;dbname=genealogia
DB_USER_GENEALOGY=genealogia_app
DB_PASSWORD_GENEALOGY=
#
# POS: SQLite is enough for a single store on one server; switch to
# PostgreSQL for several app servers or heavy concurrent checkout.
DB_DSN_POS=sqlite:/var/lib/url-routing/pos.sqlite
DB_USER_POS=
DB_PASSWORD_POS=

# --- APM / monitoring (Support/APM.php) ---
# Sin efecto: la clase no la llama nadie (marcada @deprecated). Estas variables solo la configurarían a ella.
# Master switch; when false, no transactions/errors/metrics are recorded or sent.
APM_ENABLED=false
APM_SERVICE_NAME=php-app
APM_ENVIRONMENT=development
# Fraction of transactions to sample, from 0.0 to 1.0.
APM_SAMPLE_RATE=1.0
# HTTP(S) endpoint that accepts the JSON payload (New Relic, DataDog, or your own collector).
APM_ENDPOINT=
APM_API_KEY=

# --- Frontend asset optimization (Support/AssetOptimizer.php) ---
# Sin efecto: la clase no la llama nadie (marcada @deprecated). Estas variables solo la configurarían a ella.
ASSET_MINIFY=false
ASSET_LAZY_LOAD=true
