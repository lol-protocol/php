%% Modelo de clases (PHP). Java tiene Normaliza, Sinonimos, Libro, Pasaje, Indice y Conversador (sin EPUB, colecciones ni modo largo).
classDiagram
    class Libro {
        +string titulo
        +string autor
        +list~Pasaje~ pasajes
        +list~string~ obras
        +desdeTexto(texto) Libro
        +desdeArchivo(ruta) Libro
        +coleccion(titulo, libros) Libro
    }
    class Epub {
        +MAX_ENTRADA
        +desdeArchivo(ruta) Libro
        +resolver(carpeta, href) string?
    }
    class Biblioteca {
        +ids() list~string~
        +cargar(id) Libro
        +cargarRuta(ruta) Libro
        +sinonimosDeRuta(raiz, ruta) Sinonimos
    }
    class Ajustes {
        +PASAJES_LIBRO_LARGO = 1000
        +paraLibro(libro) Ajustes
    }
    class Ventanas {
        +partir(pasajes, ventana, solape, corto) list
    }
    class Parafrasea {
        +MODERNO
        +ORIGINAL
        +responder(terminos, pregunta, capitulo, pasaje, estilo) array
    }
    class Pasaje {
        +string capitulo
        +string texto
    }
    class Normaliza {
        +texto(s) string
        +palabras(s) list~string~
        +terminos(s) list~string~
        +raiz(palabra) string
    }
    class Sinonimos {
        +desdeTexto(texto) Sinonimos
        +desdeArchivos(rutas) Sinonimos
        +expandir(terminos) list~string~
    }
    class Indice {
        -map idf
        -list vectores
        +buscar(terminos, k) list~Resultado~
    }
    class Resultado {
        +int pasaje
        +float puntaje
    }
    class Conversador {
        +UMBRAL = 0.10
        +MAX_CITAS = 2
        +intencion(pregunta) string?
        +pasajesPara(pregunta, max) list~Cita~
        +responder(pregunta) string
        +noEncuentro() string
    }
    class Dialogo {
        +MAX_PASAJES_IA = 4
        +MAX_HISTORIAL = 3
        +responder(pregunta, historial) array
    }
    class Generador {
        <<interface>>
        +generar(titulo, autor, pregunta, pasajes, historial) string
    }
    class GeneradorClaude {
        +disponible() bool
        +construirSolicitud(...) array
    }
    class GeneradorError
    class Api {
        +MAX_PREGUNTA = 500
        +manejar(metodo, accion, cabeceras, cuerpo) array
    }

    Libro "1" *-- "many" Pasaje
    Libro ..> Epub : si es .epub
    Biblioteca --> Libro : arma libros y colecciones
    Conversador --> Ajustes : cómo se busca
    Conversador ..> Ventanas : libro largo
    Conversador ..> Parafrasea : libro largo
    Conversador --> Libro : lee
    Conversador --> Indice : consulta
    Conversador --> Sinonimos : amplía la pregunta
    Conversador ..> Normaliza : usa
    Libro ..> Normaliza : usa
    Sinonimos ..> Normaliza : usa
    Indice "1" --> "many" Resultado : devuelve
    Dialogo --> Conversador
    Dialogo --> Generador : opcional
    Generador <|.. GeneradorClaude
    GeneradorClaude ..> GeneradorError : lanza
    Dialogo ..> GeneradorError : atrapa
    Api --> Dialogo : arma uno por pedido
    Api --> Biblioteca : lista y carga
