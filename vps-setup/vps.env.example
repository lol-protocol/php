# Copia este archivo a vps.env (esta en .gitignore) y completalo.
# NUNCA guardes contrasenas aqui ni en el repo: usa llave SSH.
VPS_HOST=            # IP o hostname del VPS
VPS_USER=ubuntu      # usuario con sudo (no root)
VPS_PORT=22
VPS_KEY=             # ruta a tu llave PRIVADA, ej. ~/.ssh/id_ed25519 (vacio = la de tu agente SSH)
REMOTE_DIR=vps-setup-run
