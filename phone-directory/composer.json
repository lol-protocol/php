{
    "name": "lol-protocol/phone-directory",
    "description": "Phone Directory Parser module for parsing historical phone directories and organizing genealogical records",
    "license": "MIT",
    "authors": [
        {
            "name": "LOL Protocol Team"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "bin": [
        "bin/phonedir"
    ],
    "autoload": {
        "psr-4": {
            "DefamatoryContentReview\\": "../defamatory-content-review/src/DefamatoryContentReview/",
            "PhoneDirectory\\": "src/PhoneDirectory/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
