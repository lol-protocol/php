{
  "name": "copyright-laws",
  "version": "1.0.0",
  "description": "Global copyright laws database by jurisdiction - for digital libraries and PDF documentation projects",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "validate": "node scripts/validate-csv.js",
    "build": "node scripts/reorganize-by-jurisdiction.js",
    "build:check": "node scripts/reorganize-by-jurisdiction.js --check",
    "cache:texts": "php scripts/cache-texts.php",
    "test:e2e": "node --test --test-concurrency=1 'tests/e2e/*.e2e.js'",
    "check:links": "node scripts/check-links.js"
  },
  "keywords": [
    "copyright",
    "intellectual-property",
    "books",
    "authors-rights",
    "library",
    "compliance",
    "fair-use"
  ],
  "author": "lol-protocol",
  "license": "MIT",
  "devDependencies": {
    "axe-core": "4.10.3",
    "csv-parse": "^5.5.0",
    "playwright": "1.56.1"
  }
}
