{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diseno.schema.json",
  "title": "Diseño de marcalibros",
  "description": "El aspecto de un marcalibros, independiente de dónde se use. Dos orígenes: una pieza del catálogo (inmutable, la genera build.py) o una receta de usuario (JSON declarativo, se renderiza en el servidor; nunca se guarda un SVG ni una imagen sin recodificar).",
  "type": "object",
  "required": ["id", "origen", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^(cat:[a-z0-9-]+-[0-9]{2}|usr:[0-9a-f]{32})$", "description": "cat:<id de pieza del manifest> o usr:<uuid sin guiones>"},
    "origen": {"enum": ["catalogo", "usuario"]},
    "version": {"const": 1, "description": "versión del modelo, no del diseño"},
    "pieza": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{2}$", "description": "solo catálogo: id de la pieza en catalog/manifest.json"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "solo catálogo: hash del archivo en el momento de referenciarlo; si cambia, el diseño se ha regenerado"},
    "receta": {"$ref": "#/$defs/receta"},
    "propietario": {"type": "string", "minLength": 1, "maxLength": 64, "description": "solo usuario: id de cuenta"},
    "creado": {"type": "string", "format": "date-time"},
    "visibilidad": {"enum": ["privado", "compartido"], "default": "privado"},
    "moderacion": {"enum": ["pendiente", "aprobado", "rechazado"], "description": "solo usuario: un diseño compartido exige aprobado"}
  },
  "allOf": [
    {"if": {"properties": {"origen": {"const": "catalogo"}}},
     "then": {"required": ["pieza"], "properties": {"id": {"pattern": "^cat:"}}, "not": {"anyOf": [{"required": ["receta"]}, {"required": ["propietario"]}, {"required": ["moderacion"]}]}}},
    {"if": {"properties": {"origen": {"const": "usuario"}}},
     "then": {"required": ["receta", "propietario", "creado"], "properties": {"id": {"pattern": "^usr:"}}, "not": {"anyOf": [{"required": ["pieza"]}, {"required": ["sha256"]}]}}},
    {"if": {"properties": {"visibilidad": {"const": "compartido"}}, "required": ["visibilidad"]},
     "then": {"properties": {"moderacion": {"const": "aprobado"}}, "required": ["moderacion"]}}
  ],
  "$defs": {
    "receta": {
      "type": "object",
      "required": ["fondo"],
      "additionalProperties": false,
      "properties": {
        "fondo": {
          "oneOf": [
            {"type": "object", "required": ["tipo", "pieza"], "additionalProperties": false,
             "properties": {"tipo": {"const": "plantilla"}, "pieza": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{2}$"}}},
            {"type": "object", "required": ["tipo", "paleta", "arquetipo"], "additionalProperties": false,
             "properties": {"tipo": {"const": "generado"}, "paleta": {"type": "string", "pattern": "^[a-z]+$"}, "arquetipo": {"type": "string", "pattern": "^[a-z]+$"},
                            "motivo": {"type": "string", "pattern": "^[a-z_]+$"}, "semilla": {"type": "integer", "minimum": 0, "maximum": 4294967295}}},
            {"type": "object", "required": ["tipo", "imagen", "recorte"], "additionalProperties": false,
             "properties": {"tipo": {"const": "imagen"},
                            "imagen": {"type": "string", "pattern": "^[0-9a-f]{32}$", "description": "id de un archivo subido y recodificado (JPG/PNG/WebP); nunca una URL ni un SVG"},
                            "recorte": {"$ref": "#/$defs/recorte"}}}
          ]
        },
        "texto": {
          "type": "object",
          "required": ["frase"],
          "additionalProperties": false,
          "properties": {
            "frase": {"type": "string", "minLength": 1, "maxLength": 200},
            "autor": {"type": "string", "maxLength": 60},
            "tono": {"enum": ["claro", "oscuro"], "description": "se valida contraste ≥4,5:1 contra el fondo al renderizar"}
          }
        }
      }
    },
    "recorte": {
      "type": "object",
      "required": ["x", "y", "ancho", "alto"],
      "additionalProperties": false,
      "description": "Región, en píxeles de la imagen GUARDADA (ya orientada y reducida a ≤4000 px; ver AlmacenSubidas.dimensiones), no de la original; debe ser 1:7 (alto = 7 × ancho, con ±1 px de tolerancia).",
      "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
                     "ancho": {"type": "integer", "minimum": 50, "maximum": 4000}, "alto": {"type": "integer", "minimum": 350, "maximum": 28000}}
    }
  }
}
