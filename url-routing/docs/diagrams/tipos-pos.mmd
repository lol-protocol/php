    seg -->|4 digitos| grupo["grupo\nGrupoController\n(sin acciones)"]
    seg -.->|1-3 digitos| libre["(libre — headroom\npara tipos futuros)"]

    literal["Ruta literal\n(excepcion: ingles, sin guiones)"] --> cart["cart\nCartController"]
    literal --> checkout["checkout\nCheckoutController\nindex · shipping · payment · confirm"]
    literal --> order["order/{id}\nOrderController\n1 invoice · 2 track · 3 devolucion"]

    reservado["Ruta exacta"] -->|vacio, con ?t= y ?q=| home["HomeController\nlistado / busqueda"]
