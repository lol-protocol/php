# Copy this file to .env and adjust values for your environment.
# Config::get() falls back to these when no real environment variable is set.

# --- Application ---
# Enables verbose error output. Never "true" in production.
DEBUG=false

# --- Domain routing (index.php) ---
# Comma-separated list of hostnames served by the POS (Contrastocolor) site.
# Any other host falls back to the genealogy site.
POS_DOMAINS=contrastocolor.local,contrastocolor.test,contrastocolor.app

# --- Rate limiting (Support/RateLimiter.php) ---
# Comma-separated IPs of your own reverse proxies / load balancers. Only when
# the direct peer is one of these is X-Forwarded-For used to find the client
# IP; leave empty when the app is exposed directly.
TRUSTED_PROXIES=

# --- Logging (Support/Logger.php) ---
# Absolute path to the log file. Defaults to sys_get_temp_dir()/app.log.
LOG_FILE=/var/log/app/app.log
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Databases (Support/Database.php) — see docs/DATABASE.md ---
# Each site needs its own database (their tables share names): DB_DSN_<SITE>,
# or sqlite:var/<site>.sqlite when unset (local development). There is no
# shared DB_DSN. The same SQL runs on SQLite and PostgreSQL; pick per site
# by volume.
#
# Genealogy: PostgreSQL recommended in production (large, recursive, many writers).
DB_DSN_GENEALOGY=pgsql:host=127.0.0.1;port=5432;dbname=genealogia
DB_USER_GENEALOGY=genealogia_app
DB_PASSWORD_GENEALOGY=
#
# POS: SQLite is enough for a single store on one server; switch to
# PostgreSQL for several app servers or heavy concurrent checkout.
DB_DSN_POS=sqlite:/var/lib/url-routing/pos.sqlite
DB_USER_POS=
DB_PASSWORD_POS=

# --- APM / monitoring (Support/APM.php) ---
# Master switch; when false, no transactions/errors/metrics are recorded or sent.
APM_ENABLED=false
APM_SERVICE_NAME=php-app
APM_ENVIRONMENT=development
# Fraction of transactions to sample, from 0.0 to 1.0.
APM_SAMPLE_RATE=1.0
# HTTP(S) endpoint that accepts the JSON payload (New Relic, DataDog, or your own collector).
APM_ENDPOINT=
APM_API_KEY=

# --- Frontend asset optimization (Support/AssetOptimizer.php) ---
ASSET_MINIFY=false
ASSET_LAZY_LOAD=true
